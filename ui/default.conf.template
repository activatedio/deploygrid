server {
    # 8081: the API container in the same pod owns 8080
    listen       8081;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    location /api/ {
        # collectors post full snapshots here; match the API's 64 MiB limit
        # (nginx defaults to 1m and answers 413 above it)
        client_max_body_size   64m;
        proxy_request_buffering off;
        proxy_pass         http://127.0.0.1:${API_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /swagger.json {
        proxy_pass http://127.0.0.1:${API_PORT}/swagger.json;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /healthz {
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
